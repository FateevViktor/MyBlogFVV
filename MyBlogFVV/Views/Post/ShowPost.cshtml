@model MyBlogFVV.WEB.Models.Post.PostViewModel

@{
    ViewData["Title"] = "ShowPost";
}

<div class="ContentCenter">
    <!------------- выводим теги -------------->
    <div>
        <label>Используемые теги: </label>
        @for (int i = 0; i < Model.Tag.Count; i++)
        {
            <label>@Model.Tag[@i].Text </label>
        }
    </div>
    <br />
    <!----------------------------------------->
    <div class="ContentPost">
        <h2>@Model.Title</h2>
        <p>
            @Html.Raw(@Model.Text)
        </p>
        <p>
            Автор статьи: @Model.Author.LastName @Model.Author.FirstName @Model.Author.MiddleName
        </p>
        <p>
            Дата статьи: @Model.PostDate?.ToShortDateString();
        </p>
    </div>
    <div class="ContentComment">
        <p>
            Добавить комментарий:
        </p>
        
        <form method="post" asp-controller="Comment" asp-action="Add">
            <p>
                <label>Комментарий:</label><br />
                <textarea class="TextComment" name="text"></textarea>
            </p>
            <div hidden>
                <input type='text' value=@User.Identity?.Name name='login' /><br />
                <input type='number' value=@Model.Id name='postId' /><br />
            </div>
            <input class="btn" type='submit' value='Создать' />
        </form>

        <p>
            Комментарии к посту:
        </p>
        @foreach (var item in @Model.Comment)
        {
            <partial name="_ShowComment" model="item" />
        }

    </div>
    <div>

    </div>
</div>
