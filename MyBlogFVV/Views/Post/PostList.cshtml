@inject IHttpContextAccessor HttpContextAccessor
@model MyBlogFVV.WEB.Models.Post.SearchPostsViewModel;

@{
    var username = HttpContextAccessor.HttpContext.User.Identity.Name;
    var IsInRoleAdmin = HttpContextAccessor.HttpContext.User.IsInRole("Admin");
    var IsInRoleModerator = HttpContextAccessor.HttpContext.User.IsInRole("Moderator");
}

<div class="ContentCenter">
    <div>
        <div>
            <form asp-area="" asp-controller="Post" asp-action="PostList" method="post">
                <input class="ipt" type="number" placeholder="Поиск по Id" name="Id" />
            </form>
        </div>

        <div>

            @if (Model.PostList.Count != 0)
            {
                <table class="tbl">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Дата</th>
                            <th>Автор</th>
                            <th>Название</th>
                            <th>Почитать</th>
                            <th>Удалить</th>
                            <th>Редактировать</th>
                        </tr>
                    </thead>
                    @foreach (var post in @Model.PostList)
                    {
                        <tbody>
                            <tr>
                                <!--Id-->
                                <td>
                                    @post.Id
                                </td>
                                <!--Дата-->
                                <td>
                                    @post.PostDate.ToString()
                                </td>
                                <!--Автор-->
                                <td style="min-width:300px">@post.Author.FirstName @post.Author.LastName @post.Author.MiddleName</td>
                                <!--Заголовок-->
                                <td>
                                    @post.Title
                                </td>
                                <!--Кнопка почитать статью-->
                                <td>
                                    <form asp-controller="Post" asp-action="ShowPost" method="get">
                                        <div  hidden>
                                            <input type='number' value=@post.Id name='id' /><br />
                                        </div>                                        
                                        <button type="submit" class="btn">
                                            Почитать статью
                                        </button>
                                    </form>
                                </td>
                                <!--Кнопка удаления поста-->
                                <td>
                                    @if (username == post.Author.Login || IsInRoleAdmin == true)
                                    {
                                        <form asp-controller="Post" asp-action="Delete" asp-route-id=@post.Id method="post">
                                            <button type="submit" class="btn">
                                                Удалить статью
                                            </button>
                                        </form>
                                    }
                                </td>

        
                                <!--Кнопка редактирования поста-->                                
                                <td>
                                    @if (username == post.Author.Login || IsInRoleAdmin == true || IsInRoleModerator == true)
                                    {
                                        <form asp-controller="Post" asp-action="Edit" asp-route-id=@post.Id method="post">
                                            <button type="submit" class="btn">
                                                Редактировать статью
                                            </button>
                                        </form>
                                    }
                                </td>

                            </tr>
                        </tbody>
                    }
                    <tfoot>
                        <tr><td>Всего статей </td><td>@Model.PostList.Count</td></tr>
                    </tfoot>
                </table>
            }
            else
            {
                <label> Поиск не дал результатов.</label>
            }
        </div>
    </div>
</div>
