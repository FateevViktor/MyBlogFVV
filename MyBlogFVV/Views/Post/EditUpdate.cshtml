@model MyBlogFVV.WEB.Models.Post.PostEditViewModel

@{
    ViewData["Title"] = "EditUpdate";
}
<div class="ContentCenter">
    <div>
        <h2>Редактирование статьи</h2>
        <form method="post" asp-controller="Post" asp-action="EditUpdate">
            <div class="MessageError" asp-validation-summary="ModelOnly"></div>
            <h2>Используемые теги</h2>
            <!------------- выводим теги -------------->
            @for (int i = 0; i < Model.Tag.Count; i++)
            {
                <div>
                    <div hidden>
                        <input type="number" asp-for="Tag[@i].Id" /><br />
                        <input type="text" asp-for="Tag[@i].Text" /><br />
                    </div>
                    <input type="checkbox" asp-for="Tag[@i].Checked" />@Model.Tag[i].Text<br />
                </div>
            }
            <!------------------------------------------>
            <div hidden>
                <label asp-for="Id"></label><br />
                <input asp-for="Id" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="Id"></span>
                </div>
            </div>
            <div>
                <label asp-for="PostDate"></label><br />
                <input asp-for="PostDate" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="PostDate"></span>
                </div>
            </div>
            <div>
                <label asp-for="Title"></label><br />
                <input asp-for="Title" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="Title"></span>
                </div>
            </div>
            <div class="ContentPost">
                <label asp-for="Summary"></label><br />
                <textarea class="TextPost" asp-for="Summary"></textarea>
                <div>
                    <span class="MessageError" asp-validation-for="Summary"></span>
                </div>
            </div>
            <div class="ContentPost">
                <label asp-for="Text"></label><br />
                <textarea class="TextPost" asp-for="Text"></textarea>
                <div>
                    <span class="MessageError" asp-validation-for="Text"></span>
                </div>
            </div>
            <div>
                <input type="submit" value="Сохранить" class="btn" />
            </div>
        </form>
    </div>
</div>
