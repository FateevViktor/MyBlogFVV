@inject IHttpContextAccessor HttpContextAccessor

@{
    var username = HttpContextAccessor.HttpContext.User.Identity.Name;
    var roles = HttpContextAccessor.HttpContext.User.Claims.ToList();
    var roles1 = HttpContextAccessor.HttpContext.User.IsInRole("Admin");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyBlogFVV</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="topnav">
            <a asp-area="" asp-controller="Home" asp-action="Index">DogsMyLife</a>
            <partial name="_ExitPartial" />
        </div>
        <div class="HeaderMenu">
            <nav>
                <a href="/">Главная страница</a>
                <a href="/About">Страница About</a>
                <a href="/Contacts">Контакты</a>
                @if (username == null)
                {
                <a href="/User/Login">Войти</a>               
                    <a href="/User/Register">Зарегистрироваться</a>
                }
                else
                {
                    <a href="/User/MyPage">Мой профиль</a>
                }
            </nav>
        </div>
    </header>
    <main role="main">
        @RenderBody()
    </main>
    <footer>Сайт создан студией Полет. fateevvv@yandex.ru</footer>
</body>
</html>
