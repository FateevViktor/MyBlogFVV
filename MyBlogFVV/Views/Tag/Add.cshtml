@model MyBlogFVV.WEB.Models.Tag.TagViewModel

@{
    ViewData["Title"] = "TagAdd";
}

<div class="ContentCenter">
    <h2>Создание нового тега</h2>
    <form method="post" asp-controller="Tag" asp-action="Add">
        <div class="MessageError" asp-validation-summary="ModelOnly"></div>
        <div>
            <label asp-for="Text"></label><br />
            <input asp-for="Text" />
            <div>
                <span class="MessageError" asp-validation-for="Text"></span>
            </div>
        </div>
        <div>
            <input class="btn" type="submit" value="Создать тег" />
        </div>
    </form>
    <a href="/Tag/TagList">Перейти к списку всех тегов</a>
</div>
