@model MyBlogFVV.WEB.Models.Tag.TagEditViewModel

@{
    ViewData["Title"] = "TagEdit";
}
<div class="ContentCenter">
    <div>
        <h2>Редактирование тега</h2>
        <form method="post" asp-controller="Tag" asp-action="UpdateEdit">
            <div class="MessageError" asp-validation-summary="ModelOnly"></div>
            <div hidden>
                <label asp-for="Id"></label><br />
                <input asp-for="Id" class="ipt" readonly />
                <div>
                    <span class="MessageError" asp-validation-for="Id"></span>
                </div>
            </div>
            <div>
                <label asp-for="Text"></label><br />
                <input asp-for="Text" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="Text"></span>
                </div>
            </div>
            <div>
                <input type="submit" value="Сохранить" class="btn" />
            </div>
        </form>
        <a href="/Tag/TagList">Перейти к списку тегов</a>
    </div>
</div>

