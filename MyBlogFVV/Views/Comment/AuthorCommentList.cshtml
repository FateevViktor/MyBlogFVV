@model MyBlogFVV.WEB.Models.Comment.SearchCommentsViewModel;

<div class="ContentCenter">
    <div>
        <div>

            @if (Model.CommentList.Count != 0)
            {
                <table class="tbl">
                    <thead>
                        <tr><th>Id</th><th>Дата</th><th>Название статьи</th><th>Комментарий</th><th>Удалить</th><th>Редактировать</th></tr>
                    </thead>
                    @foreach (var item in @Model.CommentList)
                    {
                        <tbody>
                            <tr>
                                <!--Id-->
                                <td>
                                    @item.Id
                                </td>
                                <!--Дата-->
                                <td>
                                    @item.CommentDate.ToShortDateString()
                                </td>
                                <!--Заголовок статьи-->
                                <td>
                                    @item.Post.Title
                                </td>
                                <!--Комментарий-->
                                <td>
                                    @item.Text
                                </td>
                                <!--Кнопка удаления комментария-->
                                <td>
                                    @if (User.Identity != null && (User.Identity.Name == item.Author.Login || User.IsInRole("Admin") == true))
                                    {
                                        <form asp-controller="Comment" asp-action="Delete" asp-route-commentId=@item.Id method="post">
                                            <button type="submit" class="btn">
                                                Удалить комментарий
                                            </button>
                                        </form>
                                    }
                                </td>
                                <!--Кнопка редактирования комментария-->
                                <td>
                                    @if (User.Identity != null && (User.Identity.Name == item.Author.Login || User.IsInRole("Admin") == true || User.IsInRole("Moderator") == true))
                                    {
                                        <form asp-controller="Comment" asp-action="Edit" asp-route-commentId=@item.Id method="post">
                                            <button type="submit" class="btn">
                                                Редактировать комментарий
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    }
                    <tfoot>
                        <tr><td>Всего комментариев </td><td>@Model.CommentList.Count</td></tr>
                    </tfoot>
                </table>
            }
            else
            {
                <label> Поиск не дал результатов.</label>
            }
        </div>
    </div>
</div>
