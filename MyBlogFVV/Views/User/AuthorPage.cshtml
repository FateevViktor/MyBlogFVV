@using MyBlogFVV.WEB.Models.User;
@model AuthorPageViewModel;

@{
    ViewData["Title"] = "Автор";
}

<div class="UserProfilHeader">
    <!-- пишем заголовок и пояснительный текст -->
    <h2>@Model?.LastName @Model?.FirstName @Model?.MiddleName</h2>
    <p>Профиль автора</p>
</div>

<div class="UserProfil">
    <div class="UserProfilMainLeft">
        <img class="UserProfilImg" src="/img/fox_avatar.png">
    </div>

    <div>
        <!--Информация об авторе-->
        <label>Id: @Model?.Id</label><br />
        <label>Логин: @Model?.Login</label><br />
        <label>ФИО: @Model?.LastName @Model?.FirstName @Model?.MiddleName</label><br />
        <label>Дата рождения: @Model?.BirthdayDate?.ToShortDateString()</label><br />
        <label>Email: @Model?.Email</label><br />
        <label>Роли: </label>
        @foreach (var item in @Model.Roles)
        {
            <label>@item </label>
        }
        <br />
        <!--Посмотреть его статьи-->
        <div>
            <form method="get" asp-controller="Post" asp-action="AuthorPostList">
                <div hidden>
                    <input type='number' value=@Model?.Id name='Id' /><br />
                </div>
                <input class="btn" type="submit" value="Посмотреть его статьи" />
            </form>
        </div>

        <!--Посмотреть его комментарии-->
        <div>
            <form method="get" asp-controller="Comment" asp-action="AuthorCommentList">
                <div hidden>
                    <input type='number' value=@Model?.Id name='Id' /><br />
                </div>
                <input class="btn" type="submit" value="Посмотреть его комментарии" />
            </form>
        </div>
    </div>
</div>
