@using MyBlogFVV.WEB.Models.User;
@model MyBlogFVV.WEB.Models.User.LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<div class="ContentCenter">
    <h4>Добро пожаловать!</h4>
    <form method="post" asp-controller="User" asp-action="Login">
        <div asp-validation-summary="ModelOnly"></div>
        <div>
            <label asp-for="Login"></label><br />
            <input asp-for="Login"/>
            <div>
                <span class="MessageError" asp-validation-for="Login"></span>
            </div>
        </div>
        <div>
            <label asp-for="Password"></label><br />
            <input asp-for="Password"/>
            <div>
                <span class="MessageError" asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
        <div>
            <input class="btn" type="submit" value="Войти" />
        </div>
    </form>
</div>

