@model MyBlogFVV.WEB.Models.User.UserEditViewModel

@{
    ViewData["Title"] = "UserEdit";
}
<div class="ContentCenter">
    <div>
        <h2>Редактирование пользователя</h2>
        <form method="post" asp-controller="User" asp-action="Edit">
            <div asp-validation-summary="ModelOnly"></div>
            <!-- выводим роли -->
            <label>Роли: </label>
            @for (int i = 0; i < Model.Roles.Count; i++)
            {
                <label>@Model.Roles[@i] </label>
            }
            <br />
            <div>
                <label asp-for="FirstName"></label><br />
                <input asp-for="FirstName" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="FirstName"></span>
                </div>
            </div>
            <div>
                <label asp-for="LastName"></label><br />
                <input asp-for="LastName" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="LastName"></span>
                </div>
            </div>
            <div>
                <label asp-for="MiddleName"></label><br />
                <input asp-for="MiddleName" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="MiddleName"></span>
                </div>
            </div>
            <div>
                <label asp-for="Email"></label><br />
                <input asp-for="Email" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="Email"></span>
                </div>
            </div>
            <div>
                <label asp-for="BirthDate"></label><br />
                <input asp-for="BirthDate" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="BirthDate"></span>
                </div>
            </div>
            <div>
                <label>Если изменить логин, то придется заново войти в свою учетную запись</label><br />
                <label asp-for="Login"></label><br />
                <input asp-for="Login" class="ipt" />
                <div>
                    <span class="MessageError" asp-validation-for="Login"></span>
                </div>
            </div>
            <div>
                <input type="submit" value="Сохранить" class="btn" />
            </div>
        </form>
    </div>
</div>